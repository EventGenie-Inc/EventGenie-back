// ============================================================
//  EventGenie — Prisma Schema
//  Database: PostgreSQL via Neon
//  ORM: Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────

enum SubscriptionTier {
  SPARK
  CELEBRATE
  ELEVATE
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PlatformRole {
  SUPER_ADMIN
  TENANT_ADMIN
  EVENT_ADMIN
  EVENT_VENDOR
}

// NOTE — COMPLETED is never written to Event.status. It is derived at
// read time (resolveEffectiveStatus in event-status.util.ts) once a
// PUBLISHED event's last EventDay has passed, since a scheduled job to
// flip it in the database isn't reliable on this project's hosting (no
// paid cron, and in-process schedulers die when the free instance
// sleeps). Querying Postgres directly will show PUBLISHED for a
// finished event — that is expected, not a bug. CANCELLED, by
// contrast, IS written: it reflects a human decision, not a date.
enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum EventTicketing {
  FREE
  PAID
}

enum RsvpFieldType {
  TEXT
  NUMBER
  EMAIL
  PHONE
  DROPDOWN
  CHECKBOX
  DATE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum DeliveryMethod {
  EMAIL
  SMS
}

enum MediaType {
  IMAGE
  VIDEO
}

enum VendorCategory {
  CATERING
  DECOR
  FURNITURE
  PHOTOGRAPHY
  ENTERTAINMENT
  FLORISTRY
  OTHER
}

// ─────────────────────────────────────────
//  TENANT
// ─────────────────────────────────────────

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  email              String             @unique
  subscriptionTier   SubscriptionTier   @default(SPARK)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  isArchived         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users        User[]
  events       Event[]
  vendorSpaces VendorSpace[]
  eventDrafts  EventDraft[]
  smsSendLogs  SmsSendLog[]
}

// ─────────────────────────────────────────
//  USER
// ─────────────────────────────────────────

model User {
  id          String       @id @default(cuid())
  tenantId    String?
  firebaseUid String       @unique
  email       String       @unique
  username    String
  role        PlatformRole
  isActive    Boolean      @default(true)
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  // Many-to-many — replaces the old single vendorSpaceId FK (Vendor Space
  // Follow-up batch). A person may legitimately manage more than one
  // vendor business; the join table also allows several users on one
  // space (a vendor business with multiple staff), which isn't
  // artificially restricted — see vendor.service.ts.
  vendorSpaceUsers VendorSpaceUser[]
  eventsCreated    Event[]
  memoryItems      MemoryItem[]      @relation("MemoryItemUploadedByUser")
  otpRecords       OtpRecord[]
  eventDrafts      EventDraft[]
}

// ─────────────────────────────────────────
//  OTP RECORD
//  Stores 2FA OTP codes for platform users.
//  One active OTP per user at a time.
//  Expired and used records are retained
//  for audit purposes.
// ─────────────────────────────────────────

model OtpRecord {
  id        String    @id @default(cuid())
  userId    String
  otp       String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────
//  EVENT
// ─────────────────────────────────────────

model Event {
  id                 String          @id @default(cuid())
  tenantId           String
  createdByUserId    String
  name               String
  description        String?
  location           String
  address            String?
  latitude           Decimal?        @db.Decimal(10, 7)
  longitude          Decimal?        @db.Decimal(10, 7)
  coverImageUrl      String?
  // Cloudinary's asset id for coverImageUrl, when the cover was uploaded
  // through the signed-upload flow (src/modules/upload/) rather than
  // pasted as an external link. Nullable independently of coverImageUrl —
  // an externally-hosted URL has no Cloudinary asset to reference. Needed
  // to delete the old asset on replace and for any future
  // transform/thumbnail generation (see Batch B report).
  coverImagePublicId String?
  status             EventStatus     @default(DRAFT)
  visibility         EventVisibility @default(PRIVATE)
  ticketing          EventTicketing  @default(FREE)
  invitationTemplate String?
  invitationConfig   String?
  // Independent of Event.status — closes guest self-service RSVP only.
  // Organiser guest management is unaffected. Never folded into
  // resolveEffectiveStatus (event-status.util.ts).
  rsvpDeadline       DateTime?
  // The VENUE's physical capacity — informational, not a billing limit.
  // Distinct from SubscriptionTierConfig.maxGuestsPerEvent; never conflate
  // the two. Warns via acceptedGuestCount on the event detail response,
  // never blocks guest creation/import.
  capacity           Int?
  isArchived         Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdBy          String
  updatedBy          String

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  createdByUser User          @relation(fields: [createdByUserId], references: [id])
  eventDays     EventDay[]
  invites       Invite[]
  guests        Guest[]
  memoryHub     MemoryHub?
  rsvpFields    RsvpField[]
  program       EventProgram?
  tickets       Ticket[]
}

// ─────────────────────────────────────────
//  EVENT DAY
//
//  label is unique per event (case-sensitively, at the DB level — a
//  race-condition backstop). The human-meaningful check is
//  case-insensitive and lives in event-day-validation.util.ts, since two
//  days labelled "Saturday" and "saturday" are the same ambiguity to
//  someone typing a spreadsheet even though Postgres treats them as
//  distinct strings.
// ─────────────────────────────────────────

model EventDay {
  id         String    @id @default(cuid())
  eventId    String
  label      String
  date       DateTime  @db.Date
  startTime  DateTime?
  endTime    DateTime?
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String
  updatedBy  String

  event          Event            @relation(fields: [eventId], references: [id])
  inviteEventDay InviteEventDay[]
  attendances    Attendance[]

  @@unique([eventId, label])
}

// ─────────────────────────────────────────
//  GUEST
//
//  firstName/surname are optional — a guest imported by phone/email alone
//  has no name until they RSVP and provide one.
//
//  Prisma cannot express "at least one of email/phoneNumber" as a column
//  constraint, so this rule — and its stricter companion, "exactly one of
//  email/phoneNumber at creation/update time, never both, never neither" —
//  is enforced in guest-validation.util.ts and called from every
//  create/update path in guest.service.ts. The second contact field is
//  meant to be filled in later, at RSVP time, not here.
// ─────────────────────────────────────────

model Guest {
  id          String   @id @default(cuid())
  eventId     String
  firstName   String?
  surname     String?
  email       String?
  phoneNumber String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id])
  invites     Invite[]
  memoryItems MemoryItem[] @relation("MemoryItemUploadedByGuest")
}

// ─────────────────────────────────────────
//  INVITE
// ─────────────────────────────────────────

model Invite {
  id                 String         @id @default(cuid())
  eventId            String
  guestId            String
  token              String         @unique
  status             InviteStatus   @default(PENDING)
  used               Boolean        @default(false)
  usedAt             DateTime?
  expiresAt          DateTime?
  editToken          String?        @unique
  editTokenExpiresAt DateTime?
  deliveryMethod     DeliveryMethod
  deliveredAt        DateTime?
  isArchived         Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  createdBy          String
  updatedBy          String

  event           Event            @relation(fields: [eventId], references: [id])
  guest           Guest            @relation(fields: [guestId], references: [id])
  inviteEventDay  InviteEventDay[]
  attendances     Attendance[]
  rsvpResponses   RsvpResponse[]
  ticketPurchases TicketPurchase[]
  smsSendLogs     SmsSendLog[]
}

// ─────────────────────────────────────────
//  INVITE EVENT DAY
// ─────────────────────────────────────────

model InviteEventDay {
  id         String   @id @default(cuid())
  inviteId   String
  eventDayId String
  createdAt  DateTime @default(now())

  invite   Invite   @relation(fields: [inviteId], references: [id])
  eventDay EventDay @relation(fields: [eventDayId], references: [id])

  @@unique([inviteId, eventDayId])
}

// ─────────────────────────────────────────
//  ATTENDANCE
// ─────────────────────────────────────────

model Attendance {
  id          String   @id @default(cuid())
  inviteId    String
  eventDayId  String
  confirmedAt DateTime @default(now())

  invite   Invite   @relation(fields: [inviteId], references: [id])
  eventDay EventDay @relation(fields: [eventDayId], references: [id])

  @@unique([inviteId, eventDayId])
}

// ─────────────────────────────────────────
//  MEMORY HUB
// ─────────────────────────────────────────

model MemoryHub {
  id          String    @id @default(cuid())
  eventId     String    @unique
  title       String?
  description String?
  isPublic    Boolean   @default(false)
  shareToken  String?   @unique
  opensAt     DateTime?
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String
  updatedBy   String

  event       Event        @relation(fields: [eventId], references: [id])
  memoryItems MemoryItem[]
}

// ─────────────────────────────────────────
//  EVENT DRAFT
//  Autosave scratchpad for the event-creation
//  wizard. One in-progress draft per tenant+user.
//  Deleted outright once materialized or
//  discarded — not a soft-deleted record.
// ─────────────────────────────────────────

model EventDraft {
  id              String   @id @default(cuid())
  tenantId        String
  createdByUserId String
  currentStep     Int      @default(1)
  payload         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  createdByUser User   @relation(fields: [createdByUserId], references: [id])

  @@unique([tenantId, createdByUserId])
}

// ─────────────────────────────────────────
//  MEMORY ITEM
// ─────────────────────────────────────────

model MemoryItem {
  id                String    @id @default(cuid())
  memoryHubId       String
  uploadedByGuestId String?
  uploadedByUserId  String?
  mediaUrl          String
  mediaType         MediaType
  caption           String?
  isApproved        Boolean   @default(false)
  isArchived        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  updatedBy         String

  memoryHub       MemoryHub @relation(fields: [memoryHubId], references: [id])
  uploadedByGuest Guest?    @relation("MemoryItemUploadedByGuest", fields: [uploadedByGuestId], references: [id])
  uploadedByUser  User?     @relation("MemoryItemUploadedByUser", fields: [uploadedByUserId], references: [id])
}

// ─────────────────────────────────────────
//  VENDOR SPACE
// ─────────────────────────────────────────

model VendorSpace {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  description String?
  email       String
  phoneNumber String?
  website     String?
  address     String?
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String

  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  vendorSpaceUsers VendorSpaceUser[]
  vendorServices   VendorService[]
}

// ─────────────────────────────────────────
//  VENDOR SPACE USER
//
//  Join table — replaces the old single User.vendorSpaceId FK. No
//  isArchived/updatedAt/updatedBy: this is a plain membership fact (a
//  user manages this space, or doesn't), same category as Attendance —
//  one of STEERING's two documented hard-delete exceptions — not a
//  soft-deletable business entity. "Unassign" hard-deletes the row.
// ─────────────────────────────────────────

model VendorSpaceUser {
  id            String   @id @default(cuid())
  vendorSpaceId String
  userId        String
  createdAt     DateTime @default(now())
  createdBy     String

  vendorSpace VendorSpace @relation(fields: [vendorSpaceId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([vendorSpaceId, userId])
}

// ─────────────────────────────────────────
//  VENDOR SERVICE
// ─────────────────────────────────────────

model VendorService {
  id             String         @id @default(cuid())
  vendorSpaceId  String
  name           String
  category       VendorCategory
  description    String?
  operatingDays  String?
  operatingHours String?
  isArchived     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String
  updatedBy      String

  vendorSpace VendorSpace @relation(fields: [vendorSpaceId], references: [id])
  products    Product[]
}

// ─────────────────────────────────────────
//  PRODUCT
// ─────────────────────────────────────────

model Product {
  id              String   @id @default(cuid())
  vendorServiceId String
  name            String
  description     String?
  price           Decimal? @db.Decimal(10, 2)
  currency        String   @default("ZAR")
  imageUrls       String[]
  isAvailable     Boolean  @default(true)
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  updatedBy       String

  vendorService VendorService @relation(fields: [vendorServiceId], references: [id])
}

// ─────────────────────────────────────────
//  RSVP FIELD
// ─────────────────────────────────────────

model RsvpField {
  id         String        @id @default(cuid())
  eventId    String
  label      String
  fieldType  RsvpFieldType
  isRequired Boolean       @default(false)
  options    String?
  order      Int
  isArchived Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  createdBy  String
  updatedBy  String

  event     Event          @relation(fields: [eventId], references: [id])
  responses RsvpResponse[]
}

// ─────────────────────────────────────────
//  RSVP RESPONSE
// ─────────────────────────────────────────

model RsvpResponse {
  id          String   @id @default(cuid())
  inviteId    String
  rsvpFieldId String
  value       String
  createdAt   DateTime @default(now())

  invite    Invite    @relation(fields: [inviteId], references: [id])
  rsvpField RsvpField @relation(fields: [rsvpFieldId], references: [id])

  @@unique([inviteId, rsvpFieldId])
}

// ─────────────────────────────────────────
//  EVENT PROGRAM
// ─────────────────────────────────────────

model EventProgram {
  id          String   @id @default(cuid())
  eventId     String   @unique
  title       String?
  isPublished Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String

  event        Event         @relation(fields: [eventId], references: [id])
  programItems ProgramItem[]
}

// ─────────────────────────────────────────
//  PROGRAM ITEM
// ─────────────────────────────────────────

model ProgramItem {
  id           String   @id @default(cuid())
  programId    String
  title        String
  description  String?
  startTime    DateTime
  durationMins Int?
  order        Int
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  updatedBy    String

  program EventProgram @relation(fields: [programId], references: [id])
}

// ─────────────────────────────────────────
//  TICKET
// ─────────────────────────────────────────

model Ticket {
  id            String   @id @default(cuid())
  eventId       String
  name          String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("ZAR")
  totalQuantity Int?
  soldCount     Int      @default(0)
  isAvailable   Boolean  @default(true)
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String
  updatedBy     String

  event     Event            @relation(fields: [eventId], references: [id])
  purchases TicketPurchase[]
}

// ─────────────────────────────────────────
//  TICKET PURCHASE
// ─────────────────────────────────────────

model TicketPurchase {
  id          String   @id @default(cuid())
  ticketId    String
  inviteId    String
  quantity    Int      @default(1)
  totalPaid   Decimal  @db.Decimal(10, 2)
  currency    String   @default("ZAR")
  paymentRef  String?
  purchasedAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  invite Invite @relation(fields: [inviteId], references: [id])
}

// ─────────────────────────────────────────
//  SMS SEND LOG
//
//  One row per SUCCESSFUL SMS send only — written by the invite dispatch
//  orchestrator after a real Twilio success, never on failure (a failed
//  send costs nothing and must not consume quota). Deliberately no
//  @@unique on inviteId: a resend that succeeds writes a second row
//  against the same invite, since it costs a second real SMS. This is
//  what lets maxSmsPerMonth be enforced by counting rows in the current
//  calendar month rather than relying on Invite.deliveredAt, which would
//  undercount a guest resent more than once in the same month.
// ─────────────────────────────────────────

model SmsSendLog {
  id       String   @id @default(cuid())
  tenantId String
  inviteId String
  sentAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  invite Invite @relation(fields: [inviteId], references: [id])

  @@index([tenantId, sentAt])
}

// ─────────────────────────────────────────
//  SUBSCRIPTION TIER CONFIG
// ─────────────────────────────────────────

model SubscriptionTierConfig {
  tier                SubscriptionTier @id
  maxEvents           Int?
  maxGuestsPerEvent   Int?
  maxSmsPerMonth      Int?
  // Vendor Space Batch — number of active (non-archived) VendorSpaces a
  // tenant may own. Independent of `vendorMarketplace` below: that's an
  // all-or-nothing capability gate (can this tier use the marketplace at
  // all), this is a numeric ceiling for tiers that can. null = unlimited,
  // matching every other max* column's convention.
  maxVendorSpaces     Int?
  emailEnabled        Boolean          @default(true)
  smsEnabled          Boolean          @default(false)
  vendorMarketplace   Boolean          @default(false)
  memoryHubEnabled    Boolean          @default(false)
  dragDropBuilder     Boolean          @default(false)
  isAvailable         Boolean          @default(true)
  updatedAt           DateTime         @updatedAt
}
